class Solution {
    public int[] shuffle(int[] nums, int n) {
        // Step 1: Pack x[i] and y[i] together into the right half of the array
        for (int i = 0; i < n; i++) {
            nums[i + n] = (nums[i] << 10) | nums[i + n];
        }

        // Step 2: Unpack and place back in target positions
        for (int i = 0; i < n; i++) {
            int x = nums[i + n] >> 10;
            int y = nums[i + n] & 1023; // 1023 is 2^10 - 1 (mask for lower 10 bits)
            
            nums[2 * i] = x;
            nums[2 * i + 1] = y;
        }

        return nums;
    }
}
